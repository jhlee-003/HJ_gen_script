# Submit from Run3/2022 after creating the destination directories:
#   mkdir -p logs condor_output
#   condor_submit config/HJ_M-125_TuneCP5_2022_condor.sub

universe = vanilla
notification = Never

# Pilot settings. Increase these only after one complete job succeeds.
events_per_job = 10
number_of_jobs = 1
number_of_threads = 2

# Condor Process and job_offset are zero-based. The production script adds one
# only when constructing the human-facing job number and output filename.
# Use a nonzero offset for a concurrent campaign to avoid reusing job seeds.
job_offset = 0
job_number_expression = $(Process) + $(job_offset) + 1
job_number = $INT(job_number_expression)

request_cpus = $(number_of_threads)
request_memory = 5000
request_disk = 8000000
+MaxWallTimeMins = 1200

log = logs/log_produce_hj_$(Cluster).$(Process).log
output = logs/log_produce_hj_$(Cluster).$(Process).out
error = logs/log_produce_hj_$(Cluster).$(Process).err

requirements = HasSingularity
+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el8:x86_64"

executable = condor_convert_wrapper.sh
arguments = $(Process) $(events_per_job) HJ_M-125_TuneCP5_2022_FullSim.env $(number_of_threads) $(job_offset)
transfer_executable = True
transfer_input_files = ProduceHJ_M-125_TuneCP5_2022.sh, config/HJ_M-125_TuneCP5_2022_FullSim.env, config/HJ_M-125_TuneCP5_2022_fragment.py

should_transfer_files = YES
when_to_transfer_output = ON_SUCCESS
transfer_output_files = condor_output.root
transfer_output_remaps = "condor_output.root=condor_output/GluGluHtoZG_Zto2L_M-125_TuneCP5_13p6TeV_powhegMiNNLO-pythia8__Run3Summer22_NanoAODv12-130X_mcRun3_2022_realistic_v5__privateProduction__condor-$(Cluster)__job-$(job_number).root"

# Failed jobs do not attempt output transfer; this policy holds on the cmsRun
# exit code instead of masking it as a missing-output transfer failure.
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)

# Delegate the current VOMS proxy; do not store a proxy in the repository.
use_x509userproxy = True

queue $(number_of_jobs)
